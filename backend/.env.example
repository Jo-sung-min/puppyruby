# 서버는 PostgreSQL DB 설정이 반드시 필요하며 로컬 H2로 자동 전환하지 않습니다.
# 이 파일을 backend/.env로 복사해 실제 접속값을 입력하세요. .env.local이 있으면 같은 키를 덮어씁니다.
# 전용 PostgreSQL DB는 DB_SCHEMA를 비우거나 생략하면 연결의 기본 스키마(보통 public)를 사용합니다.
# 한 DB를 여러 서비스가 공유할 때만 별도 스키마 이름을 지정하세요.
DB_SCHEMA=
# Leave room in a hosted pooler for migrations and management connections.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
# Flyway applies versioned SQL before Hibernate validates the same schema.
# Existing databases require an explicit reviewed baseline; automatic baseline and clean are disabled.
FLYWAY_ENABLED=true
DB_URL=jdbc:postgresql://localhost:5433/puppyruby
DB_USERNAME=puppyruby
DB_PASSWORD=replace-with-a-local-password
PORT=8080
PUBLIC_SITE_URL=http://127.0.0.1:3000
# AWS: set SERVER_ADDRESS=0.0.0.0 when the load balancer connects to this host.
SERVER_ADDRESS=127.0.0.1
# Only this email may become an administrator, after verified email ownership.
ADMIN_EMAIL=
# Enable Kakao Login and register PUBLIC_SITE_URL/api/auth/kakao/callback in Kakao Developers.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Email/password signup works without SMTP. Verification/reset email requires these settings.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true

# Toss Payments: use a matching test_ck_/test_sk_ pair for sandbox verification.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Keep false until the live merchant account and purchase policies are ready.
TOSS_LIVE_ENABLED=false

# Images: configure on the Java backend, not in NEXT_PUBLIC_* variables.
# Set true after supplying your bucket, region, CDN URL and AWS credentials/role.
S3_UPLOAD_ENABLED=false
S3_BUCKET=
AWS_REGION=ap-northeast-2
S3_KEY_PREFIX=puppyruby
CDN_BASE_URL=
# Optional: CDN origin folder already prepended by CloudFront/CDN, e.g. puppyruby or /puppyruby.
# Leave empty when the CDN origin points to the bucket root. S3 upload keys stay unchanged.
CDN_ORIGIN_PATH=
S3_PRESIGN_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=1048576
# Leave these empty when the backend already uses an AWS IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
