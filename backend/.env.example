# AWS Elastic Beanstalk > Configuration > Environment properties에 등록합니다.
# 배포 전 모든 예시 값을 교체하고 비밀값은 Git에 올리지 않습니다.

# 필수: Java 서버, Vercel 사이트 주소, PostgreSQL
PORT=8080
SERVER_ADDRESS=0.0.0.0
PUBLIC_SITE_URL=https://www.example.com
DB_URL=jdbc:postgresql://database.example.ap-northeast-2.rds.amazonaws.com:5432/puppyruby?sslmode=require
DB_USERNAME=puppyruby
DB_PASSWORD=replace-with-database-password

# 선택: 아래 이메일을 인증한 계정이 관리자가 됩니다.
# ADMIN_EMAIL=admin@example.com

# 선택: 카카오 로그인. REST 키는 Vercel에도 넣고 시크릿은 AWS에만 둡니다.
# KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key
# KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

# 선택: 이메일 인증과 비밀번호 재설정 메일
# MAIL_ENABLED=true
# MAIL_HOST=smtp.example.com
# MAIL_USERNAME=smtp-user@example.com
# MAIL_PASSWORD=replace-with-smtp-password
# MAIL_FROM=no-reply@example.com

# 선택: 토스페이먼츠 테스트 모드. 같은 상점의 키 두 개를 사용합니다.
# TOSS_CLIENT_KEY=test_ck_replace_with_client_key
# TOSS_SECRET_KEY=test_sk_replace_with_secret_key
# TOSS_LIVE_ENABLED=false

# 선택: 프로필·SEO 이미지를 S3에 직접 올리고 CDN으로 표시합니다.
# Elastic Beanstalk/EC2 IAM 역할을 사용하면 액세스 키 환경변수가 필요 없습니다.
# S3_UPLOAD_ENABLED=true
# 관리자 화면에서 Windows 실행파일 배포를 허용할 때만 별도로 켭니다.
# DESKTOP_RELEASE_UPLOAD_ENABLED=true
# S3_BUCKET=example-puppyruby-assets
# AWS_REGION=ap-northeast-2
# S3_KEY_PREFIX=puppyruby
# CDN_BASE_URL=https://cdn.example.com
# CDN 원본 경로가 이미 이 폴더로 지정된 경우에만 추가합니다.
# CDN_ORIGIN_PATH=puppyruby
# 관리자 Windows 배포는 DESKTOP_RELEASE_UPLOAD_ENABLED=true일 때 같은 연결을 사용합니다. PuppyRuby 운영 배포에서는
# S3_BUCKET=fatell-aws-s3, S3_KEY_PREFIX=puppyruby,
# CDN_BASE_URL=https://cdn.puppyruby.com, CDN_ORIGIN_PATH=puppyruby를 정확히 사용합니다.
# 실행파일 본문은 브라우저가 S3로 직접 보내며 Java/Vercel을 통과하지 않습니다.

# 기본값은 생략했습니다. 전용 DB의 기본 스키마를 사용하고 Flyway는 켜집니다.
# 메일은 587/STARTTLS, S3 업로드 URL은 300초/최대 1MiB가 기본입니다.
