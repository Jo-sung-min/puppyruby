POSTGRES_PASSWORD=replace-with-a-local-password

# Docker Compose reads this project's root .env. Use the public browser origin.
PUBLIC_SITE_URL=http://127.0.0.1:3001
# Optional administrator email. Promotion requires verified email ownership.
ADMIN_EMAIL=

# Optional Kakao login. Keep the client secret on the backend only.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Optional SMTP. Email verification and password-reset delivery are disabled by default.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true

# Optional Toss Payments API keys. Empty keys disable purchases. Never put secret keys in frontend variables.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Actual charges require matching live keys AND this explicit opt-in.
TOSS_LIVE_ENABLED=false
