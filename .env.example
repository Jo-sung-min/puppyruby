POSTGRES_PASSWORD=replace-with-a-local-password

# Docker Compose reads this project's root .env. Use the public browser origin.
PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional administrator email. Promotion requires verified email ownership.
ADMIN_EMAIL=

# Optional Kakao login. Keep the client secret on the backend only.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Optional SMTP. Email verification and password-reset delivery are disabled by default.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true

# Optional Toss Payments API keys. Empty keys disable purchases. Never put secret keys in frontend variables.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# Actual charges require matching live keys AND this explicit opt-in.
TOSS_LIVE_ENABLED=false

# S3 direct image upload + CDN. Docker forwards these to the Java backend only.
S3_UPLOAD_ENABLED=false
S3_BUCKET=
AWS_REGION=ap-northeast-2
S3_KEY_PREFIX=puppyruby
CDN_BASE_URL=
S3_PRESIGN_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=1048576
# Optional when using an IAM role. Never expose credentials in NEXT_PUBLIC_*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
