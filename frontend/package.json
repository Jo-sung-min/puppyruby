{
  "name": "puppyruby-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:accessories": "node ../scripts/sync-akita-coat.cjs && node ../scripts/prepare-ruby-accessory-catalog.cjs && node ../scripts/prepare-ruby-accessory-anchors.cjs",
    "prepare:accessories:release": "node ../scripts/sync-akita-coat.cjs && node ../scripts/prepare-ruby-accessory-catalog.cjs --require-release && node ../scripts/prepare-ruby-accessory-anchors.cjs",
    "predev": "npm run prepare:accessories",
    "dev": "node scripts/run-next.mjs dev",
    "prebuild": "npm run prepare:accessories:release",
    "build": "next build",
    "start": "node scripts/run-next.mjs start",
    "pretypecheck": "npm run prepare:accessories",
    "typecheck": "tsc --noEmit",
    "test:desktop-release": "node --test --experimental-strip-types src/lib/desktop-release-contract.test.ts"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "galmuri": "2.40.3",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
