API_URL=http://127.0.0.1:8080/api/v1
PUBLIC_SITE_URL=http://127.0.0.1:3000
# Kakao REST API key only; never put the client secret in a NEXT_PUBLIC variable.
KAKAO_REST_API_KEY=

# Vercel: API_URL must point to the deployed Java backend, including /api/v1.
# S3_BUCKET, CDN_BASE_URL, AWS_REGION and AWS credentials belong on that backend.
# This frontend reads upload availability and the CDN URL through its /api/media proxy.
# Do not add AWS secrets to NEXT_PUBLIC_* or this frontend environment.
