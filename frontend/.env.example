API_URL=http://127.0.0.1:8080/api/v1
PUBLIC_SITE_URL=http://127.0.0.1:3000
# Optional public CDN release overrides. Empty/unset uses the verified release in
# src/lib/generated/public-media-release.json; no local image files are needed.
# Example: https://cdn.puppyruby.com/site-assets/<release>
# Set in Vercel before building; changing it requires a rebuild/redeploy.
NEXT_PUBLIC_ASSET_BASE_URL=
# Example: https://cdn.puppyruby.com/site-downloads/<release>
NEXT_PUBLIC_DOWNLOAD_BASE_URL=
# Optional independent release for the Ruby Round 30-breed pack, PNGs and Aseprite files.
# Example: https://cdn.puppyruby.com/site-packs/ruby-round-v1/<release>
# Until a verified pack release is recorded, this pack uses local ignored assets.
NEXT_PUBLIC_RUBY_ROUND_BASE_URL=
# Kakao REST API key only; never put the client secret in a NEXT_PUBLIC variable.
KAKAO_REST_API_KEY=

# Vercel: API_URL must point to the deployed Java backend, including /api/v1.
# S3_BUCKET, CDN_BASE_URL, AWS_REGION and AWS credentials belong on that backend.
# Both media bases are public, unsigned CDN URLs. Downloads bypass the Next.js server.
# This frontend reads upload availability and the CDN URL through its /api/media proxy.
# Do not add AWS secrets to NEXT_PUBLIC_* or this frontend environment.
